training/.venv/
training/vendor/

# Model artefacts anywhere in the tree. None are tracked today; these patterns
# keep a multi-GB export from being committed by accident.
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
adapter_model.bin

# Raw development-history captures. The DataCollector corpus is read in place
# from its own drive and must never be copied into the repository.
DataCollector/
collected_context/
**/collected_context/
servers/macos/apple_lite/.build/

# Support brain artifacts (models, corpora, runs)
support_training/data/
# Superdesign temporary exports
.superdesign/tmp/

# Cloudflare Wrangler local account and deployment cache
.wrangler/

# LaTeX build products. latexmk regenerates all of these from the .tex and
# .bib; .fdb_latexmk and .fls additionally bake in absolute paths from the
# machine that built them, so committing them breaks a fresh clone's first run.
research/paper/*.aux
research/paper/*.bbl
research/paper/*.blg
research/paper/*.fdb_latexmk
research/paper/*.fls
research/paper/*.log
research/paper/*.out
research/paper/*.synctex.gz
research/paper/*.toc


# autoyou-research is its own PUBLIC repository (github.com/autoyou-ai/autoyou-research)
# nested inside this private one. Its contents are tracked there, never here.
/autoyou-research/

# Material that stays private: product-integration specifications naming
# internal source files, and marketing copy. Deliberately kept out of the
# public research repository.
# (tracked here; listed for orientation, not ignored)

