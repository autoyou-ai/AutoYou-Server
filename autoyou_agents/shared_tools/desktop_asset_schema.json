{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoyou.me/schemas/desktop-asset-pack-v2.json",
  "title": "AutoYou user-local desktop asset bundle",
  "type": "object",
  "required": ["schema_version", "agent_name", "asset_packs"],
  "properties": {
    "schema_version": { "const": 2 },
    "agent_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
    "app_id": { "type": "string", "maxLength": 128 },
    "title": { "type": "string", "maxLength": 160 },
    "description": { "type": "string", "maxLength": 1000 },
    "transport": { "type": "string", "maxLength": 64 },
    "process_names": {
      "type": "object",
      "propertyNames": { "enum": ["windows", "macos", "linux", "any"] },
      "additionalProperties": { "type": "array", "items": { "type": "string", "maxLength": 128 } }
    },
    "window_title_hints": {
      "type": "object",
      "propertyNames": { "enum": ["windows", "macos", "linux", "any"] },
      "additionalProperties": { "type": "array", "items": { "type": "string", "maxLength": 160 } }
    },
    "launch_commands": {
      "type": "object",
      "propertyNames": { "enum": ["windows", "macos", "linux", "any"] },
      "additionalProperties": { "type": "array", "items": { "type": "string", "maxLength": 2048 } }
    },
    "working_directory_strategy": { "type": "object" },
    "preferred_prompt_target_id": { "type": "string", "maxLength": 128 },
    "preferred_submit_target_id": { "type": "string", "maxLength": 128 },
    "preferred_copy_response_target_id": { "type": ["string", "null"], "maxLength": 128 },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
    "asset_packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/assetPack" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "assetPack": {
      "type": "object",
      "required": ["asset_pack_id", "platform", "targets"],
      "properties": {
        "asset_pack_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "platform": { "enum": ["any", "windows", "macos", "linux"] },
        "architectures": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
        "app_version": { "type": "string", "maxLength": 80 },
        "app_version_min": { "type": "string", "maxLength": 80 },
        "app_version_max": { "type": "string", "maxLength": 80 },
        "os_versions": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
        "theme": { "type": "string", "maxLength": 40, "pattern": "^(any|light|dark|high_contrast|custom:[a-z0-9][a-z0-9 _.-]{0,32})$" },
        "display_scale": { "oneOf": [{ "type": "number", "minimum": 0.5, "maximum": 4.0 }, { "const": "any" }] },
        "valid_until": { "type": ["string", "null"], "format": "date" },
        "description": { "type": "string", "maxLength": 240 },
        "coordinate_space": { "enum": ["window", "screen"] },
        "bootstrap_only": { "type": "boolean" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/target" }
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["target_id"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 240 },
        "click_point": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }], "minItems": 2, "maxItems": 2 },
        "normalized_box": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }], "minItems": 4, "maxItems": 4 },
        "anchored_point": { "$ref": "#/$defs/anchoredPoint" },
        "anchored_box": { "$ref": "#/$defs/anchoredBox" },
        "expected_image_path": { "type": "string", "maxLength": 240, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))" },
        "reference_sprite": { "type": "string", "maxLength": 240, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))" },
        "accessibility": { "type": "object" }
      },
      "additionalProperties": true
    },
    "anchorAxis": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "object",
          "properties": {
            "from": { "enum": ["left", "right", "center", "top", "bottom"] },
            "offset_px": { "type": "number" },
            "requires_room_right_px": { "type": "number", "minimum": 0 },
            "room_anchor_offset_px": { "type": "number" },
            "fallback_offset_px": { "type": "number" }
          },
          "additionalProperties": false
        }
      ]
    },
    "anchoredPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/anchorAxis" },
        "y": { "$ref": "#/$defs/anchorAxis" }
      },
      "additionalProperties": false
    },
    "anchoredBox": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "array", "items": { "$ref": "#/$defs/anchorAxis" }, "minItems": 2, "maxItems": 2 },
        "y": { "type": "array", "items": { "$ref": "#/$defs/anchorAxis" }, "minItems": 2, "maxItems": 2 }
      },
      "additionalProperties": false
    }
  }
}
