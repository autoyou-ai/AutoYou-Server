from pathlib import Path

from fastapi import Request

from autoyou_agents.shared_tools.scheduler_mission_control import (
    _api_auth_error,
    create_agent_website_app,
)


APP_ROOT = Path(__file__).resolve().parents[1]
FRONTEND_DIR = APP_ROOT / "frontend"
DIST_DIR = FRONTEND_DIR / "dist"
DIST_ASSETS_DIR = DIST_DIR / "assets"

APP_TITLE = "{{app_title}}"
UI_PURPOSE = "{{ui_purpose}}"
def register_routes(app, agent_name: str) -> None:
    @app.get("/health")
    def health() -> dict:
        return {
            "status": "ok",
            "agent_name": agent_name,
            "proxy_path": "{{proxy_path}}",
            "frontend_stack": "{{frontend_stack}}",
        }

    @app.get("/api/status")
    def status(request: Request):
        auth_error = _api_auth_error(agent_name, request)
        if auth_error:
            return auth_error
        return {
            "agent_name": agent_name,
            "ui_purpose": UI_PURPOSE,
            "frontend_stack": "{{frontend_stack}}",
            "frontend_stack_label": "{{frontend_stack_label}}",
            "recommended_local_port": {{local_port}},
            "proxy_path": "{{proxy_path}}",
            "runtime_note": "{{runtime_note}}",
        }


app = create_agent_website_app(
    agent_name="{{agent_name}}",
    title=APP_TITLE,
    description=UI_PURPOSE,
    index_path=DIST_DIR / "index.html",
    assets_dir=DIST_ASSETS_DIR,
    extra_routes_fn=register_routes,
)
