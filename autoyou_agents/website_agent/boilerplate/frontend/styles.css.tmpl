:root {
  color-scheme: light dark;
  --bg: #f5f0e8;
  --bg-grad: rgba(13, 122, 95, 0.16);
  --panel: #fffaf3;
  --panel-inset: rgba(255, 255, 255, 0.6);
  --ink: #1e1a16;
  --muted: #6c6358;
  --accent: #0d7a5f;
  --accent-ink: #ffffff;
  --border: rgba(30, 26, 22, 0.12);
  --shadow: 0 18px 48px rgba(30, 26, 22, 0.08);
  --code-bg: #15120f;
  --code-ink: #e9f6ef;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0c1117;
    --bg-grad: rgba(45, 212, 170, 0.14);
    --panel: #121a23;
    --panel-inset: rgba(255, 255, 255, 0.04);
    --ink: #e7eef5;
    --muted: #9fb0c0;
    --accent: #2dd4aa;
    --accent-ink: #06231b;
    --border: rgba(159, 176, 192, 0.18);
    --shadow: 0 22px 60px rgba(0, 0, 0, 0.5);
    --code-bg: #0a0f14;
    --code-ink: #d6f5ea;
  }
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: "IBM Plex Sans", "Segoe UI", "Helvetica Neue", sans-serif;
  color: var(--ink);
  background:
    radial-gradient(circle at top left, var(--bg-grad), transparent 42%),
    linear-gradient(180deg, color-mix(in srgb, var(--bg) 85%, #000 0%) 0%, var(--bg) 100%);
}

.app-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px 20px;
}

.panel {
  width: min(720px, 100%);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 28px;
  box-shadow: var(--shadow);
}

.eyebrow {
  margin: 0 0 8px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  font-size: 0.78rem;
  font-weight: 700;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 5vw, 3.4rem);
  line-height: 0.95;
}

.summary {
  margin: 14px 0 22px;
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.55;
}

.meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
  margin: 0 0 22px;
}

.meta div {
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 14px;
  background: var(--panel-inset);
}

dt {
  margin-bottom: 6px;
  color: var(--muted);
  font-size: 0.85rem;
}

dd {
  margin: 0;
  font-weight: 700;
}

button {
  border: 0;
  border-radius: 999px;
  padding: 12px 18px;
  background: var(--accent);
  color: var(--accent-ink);
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.16s ease, filter 0.16s ease;
}

button:hover,
button:focus-visible {
  transform: translateY(-1px);
  filter: brightness(1.05);
  outline: none;
}

pre {
  margin: 18px 0 0;
  padding: 16px;
  overflow: auto;
  border-radius: 18px;
  background: var(--code-bg);
  color: var(--code-ink);
  font: 0.9rem/1.45 "IBM Plex Mono", "SFMono-Regular", monospace;
}
