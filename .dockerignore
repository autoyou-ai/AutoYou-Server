# Platform-specific Windows build outputs are excluded below. Keep the source
# scripts, README, and AppX metadata because the server legal gate validates
# those release hooks even when the Linux image is being built.

# Release and local virtual environments are never build inputs for the
# protected Linux server image.
# AutoYou Lite source is released separately as a protected wheel. Keep only
# the dependency metadata needed by the server legal-bundle generator.
autoyou_lite/*
!autoyou_lite/pyproject.toml
!autoyou_lite/autoyou_lite/
autoyou_lite/autoyou_lite/*
!autoyou_lite/autoyou_lite/requirements.txt
autoyou_app.build/
autoyou-website/

# Server containers need only the Markdown guides read by server.py. Website
# and maintainer guide pages are published separately and must not be copied
# into the runtime image by COPY . . .
guides/interactive/
guides/*.md
guides/*.txt
!guides/installation-steps.md
!guides/WINDOWS_BUILD_GUIDE.md
!guides/MACOS_BUILD_GUIDE.md
!guides/SIGNAL_QR_PAIRING_GUIDE.md
