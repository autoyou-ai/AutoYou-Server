%% AutoYou architecture (light palette)
flowchart TB
    classDef clientNode fill:#e8f0fe,stroke:#3b6fe0,stroke-width:1.5px,color:#0b1f4d
    classDef serverCore fill:#eaf6ee,stroke:#2e8b57,stroke-width:1.5px,color:#0d3b22
    classDef webrtcPipe fill:#e0f7fa,stroke:#0097a7,stroke-width:2px,color:#004d40
    classDef extNode fill:#fff4e0,stroke:#e08a00,stroke-dasharray:5 3,stroke-width:1.5px,color:#4d2e00
    classDef bridgeNode fill:#f1f1f1,stroke:#888,stroke-dasharray:5 3,color:#333

    subgraph clients["Your Devices & Connected Clients"]
        direction LR
        subgraph phone["AutoYou Mobile App (Phone)"]
            direction TB
            phoneUI["Mobile Client & WebRTC Peer<br/>Chat · Voice · Video · WebView"]
            localchat["On-Device Local AI<br/>LFM2.5 350M · Apple Intel · Nano"]
            phoneweb["Local Web Server & Cache<br/>Serves Agent Apps to WebView"]
            phoneUI --- localchat
            phoneUI <-->|"Localhost bridge"| phoneweb
        end
        desktopApp["Desktop & Browser Clients<br/>macOS · Windows · Chrome Extension"]
        mcp["MCP Clients<br/>Cursor · Claude Desktop"]
    end

    signaling["Auto-Pair Signaling<br/>Telegram · Signal · WhatsApp · LAN"]

    subgraph webrtcSection["⚡ E2E-Encrypted WebRTC Backbone (DTLS-SRTP / SCTP)"]
        direction LR
        mediaStream["Media Streams (RTP/SRTP)<br/>Opus Audio · Video · Screen Share"]
        dataChannel["SCTP DataChannels<br/>autoyou-control & data · Chunk Acks"]
        httpTunnel["HTTP-over-SCTP Tunnel<br/>Proxies HTTP, SSE & WebSockets"]
    end

    subgraph server["AutoYou Server · Your Host Machine"]
        direction TB
        webrtcEngine["WebRTC Engine (:8002 / :signal)<br/>aiortc · DataChannelManager"]
        router["Intent Router & Dispatcher"]
        admin["Admin Console :8001"]

        subgraph harness["Agent Harness · Google ADK"]
            direction LR
            agents["AutoYou Agents (42+)<br/>Notes · Page · Browser · Coding · Files"]
            oc["OpenClaw Bridge"]
            hermes["Hermes Bridge"]
        end

        webapps["Agent Apps & Web Proxy (:8067)<br/>Interactive Frontends & HTML Screens"]
        voice["Local Voice Engine<br/>faster-whisper STT · system TTS"]
        tools["Playwright · Files · Audio Engine"]
        mem["Memory & Keystore<br/>SQLite · Argon2id"]
        llm["LiteLLM Gateway"]

        webrtcEngine <--> router
        admin --- router
        router --> harness
        harness --> webapps
        harness --> voice
        harness --> tools
        harness --> mem
        harness --> llm
    end

    emoti["EmotiVoice<br/>Optional Neural TTS"]
    cognee["Cognee<br/>Graph & Vector Memory"]
    ollama["Ollama<br/>Local Models · GGUF"]
    cloud["Optional Cloud Providers<br/>OpenAI · Anthropic · Gemini"]

    phoneUI <-->|"Auto-Pair exchange"| signaling
    desktopApp <-->|"Auto-Pair exchange"| signaling
    signaling <-->|"Messaging bridge"| router
    mcp -->|"MCP Bridge :8000"| router

    phoneUI <==>|"WebRTC PeerConnection"| webrtcSection
    desktopApp <==>|"WebRTC PeerConnection"| webrtcSection
    webrtcSection <==> webrtcEngine

    phoneweb -.->|"Tunneled via DataChannel"| httpTunnel
    httpTunnel <===>|"HTTP proxy loop"| webapps
    mediaStream <===>|"Audio / Video"| voice

    voice -.-> emoti
    mem -.-> cognee
    llm --> ollama
    llm -.-> cloud

    class phoneUI,desktopApp,localchat,phoneweb,mcp clientNode
    class webrtcSection,mediaStream,dataChannel,httpTunnel webrtcPipe
    class webrtcEngine,admin,router,agents,webapps,llm,voice,mem,tools serverCore
    class oc,hermes,ollama,emoti,cognee extNode
    class cloud,signaling bridgeNode

    style clients fill:#f4f8ff,stroke:#9db8f2,color:#0b1f4d
    style phone fill:#ebf3ff,stroke:#6495ed,color:#0b1f4d
    style webrtcSection fill:#e6f9fa,stroke:#00bcd4,color:#004d40
    style server fill:#f6fbf7,stroke:#9ccfb0,color:#0d3b22
    style harness fill:#ffffff,stroke:#9ccfb0,color:#0d3b22
